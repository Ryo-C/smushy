# Environment (development, staging, production)
EXPO_PUBLIC_ENV=development

# Data Source Configuration
# Set to 'true' to use mock data (in-memory repositories with seed data)
# Set to 'false' to use backend API (NestJS REST API)
EXPO_PUBLIC_USE_MOCK_DATA=false

# Mock Auto-Login Configuration (only applies when USE_MOCK_DATA=true)
# Set to 'false' to disable auto-login in mock mode and test the login flow
# Defaults to 'true' (auto-login enabled) if not specified
EXPO_PUBLIC_MOCK_AUTO_LOGIN=true

# Backend API URL (used when USE_MOCK_DATA=false)
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000/api
